{
  "name": "@autumn/agent",
  "version": "0.1.0",
  "private": true,
  "description": "Autumn purchase runner: one tick() that buys a little XAUt0 per plan per week under an Altana session key.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "engines": { "node": ">=22" },
  "bin": { "autumn-agent": "./dist/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "migrate": "node dist/cli.js migrate",
    "tick": "node dist/cli.js tick"
  },
  "dependencies": {
    "@altananetwork/sdk": "^1.1.0",
    "@autumn/core": "file:../core",
    "pg": "^8.16.3",
    "viem": "^2.58.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
