{
  "name": "autumn-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:deps": "npm --prefix ../core ci && npm --prefix ../core run build && npm --prefix ../agent ci && npm --prefix ../agent run build",
    "migrate": "node --env-file=.env.local ../agent/dist/cli.js migrate",
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run build:deps && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@altananetwork/sdk": "^1.1.0",
    "@autumn/agent": "file:../agent",
    "@autumn/core": "file:../core",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "uqr": "^0.1.3",
    "viem": "^2.58.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
