# Autumn web app. Copy to web/.env.local and fill in. Never commit real values.

# ---- Browser (public, inlined at build time) ----
# Deployed GoldBuyer contract on Celo mainnet, and the block it was deployed in.
NEXT_PUBLIC_AUTUMN_GOLD_BUYER_ADDRESS=
NEXT_PUBLIC_AUTUMN_GOLD_BUYER_DEPLOY_BLOCK=
# Passkey relying-party id: the app's domain. Use "localhost" for local development.
NEXT_PUBLIC_AUTUMN_RP_ID=localhost
# Optional: the exact origin passkeys may be used from.
NEXT_PUBLIC_AUTUMN_APP_ORIGIN=http://localhost:3000
# Optional: browser RPC (default https://forno.celo.org) and its eth_getLogs block limit (default 5000).
NEXT_PUBLIC_AUTUMN_CELO_RPC_URL=
NEXT_PUBLIC_AUTUMN_LOGS_BLOCK_RANGE=
# Set to 1 to show the in-memory preview instead of the real app.
NEXT_PUBLIC_AUTUMN_PREVIEW=

# ---- Server (secret, route handlers and cron) ----
# Postgres, e.g. Neon's pooled connection string with sslmode=require.
DATABASE_URL=
# 32 random bytes, hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts the agent's session keys at rest. Losing it strands every active plan.
AUTUMN_KEY_ENCRYPTION_KEY=
# Same values as the public ones above.
AUTUMN_GOLD_BUYER_ADDRESS=
AUTUMN_GOLD_BUYER_DEPLOY_BLOCK=
# Optional server RPC (default https://forno.celo.org) and eth_getLogs block limit.
AUTUMN_CELO_RPC_URL=
AUTUMN_LOGS_BLOCK_RANGE=
# "live" sends purchases. Anything else is a dry run: the agent decides and quotes but sends nothing.
AUTUMN_EXECUTION=dry-run
# Who sends purchases: "relay" (default) or "direct-prepared" (what the live deployment runs: Altana's relay
# prepares the intent, the agent wallet sends it with the attribution tag last). "direct-prepared" and "direct"
# need AUTUMN_DIRECT_SUBMITTER_KEY, the agent wallet's private key (0x + 64 hex); that wallet pays gas in CELO.
# See docs/direct-submit.md.
# AUTUMN_SUBMITTER=direct-prepared
# AUTUMN_DIRECT_SUBMITTER_KEY=
# Protects /api/cron/tick. The Cron Trigger and manual runs send "Authorization: Bearer $CRON_SECRET". At least 16 characters.
CRON_SECRET=

# Optional, for a host that runs `next start` as one long-lived server and has
# no cron: run the purchase tick in-process once per UTC hour.
# AUTUMN_SCHEDULER=internal
# Optional with the line above: a URL requested every ten minutes, so a host
# that suspends idle services keeps this one running (for example the app's
# own /api/health).
# AUTUMN_KEEP_AWAKE_URL=
