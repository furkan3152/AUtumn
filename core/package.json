{
  "name": "@autumn/core",
  "version": "0.1.0",
  "private": true,
  "description": "Autumn onchain core: Celo constants, ABIs, session-grant mapping, quotes, calldata and chain readers.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration"
  },
  "peerDependencies": {
    "@altananetwork/sdk": "^1.1.0"
  },
  "dependencies": {
    "@celo/attribution-tags": "^0.5.0",
    "viem": "^2.58.4"
  },
  "devDependencies": {
    "@altananetwork/sdk": "^1.1.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
